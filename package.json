{
  "name": "1-apply",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @1apply/web",
    "build": "npm run build -w @1apply/web",
    "build:server": "bash scripts/ec2-build.sh",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @1apply/web",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@tailwindcss/oxide@4.1.12": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.5": true,
    "esbuild@0.27.3": true,
    "puppeteer@24.43.1": true
  },
  "dependencies": {
    "approve": "^0.0.12",
    "esbuild": "^0.25.5"
  }
}
