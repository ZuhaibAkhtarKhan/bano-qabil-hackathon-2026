{
  "manifest_version": 3,
  "name": "1-Apply",
  "version": "0.2.0",
  "description": "Save opportunities to 1-Apply and fill approved fields. Never submits, signs, pays, or bypasses CAPTCHA.",
  "action": {
    "default_title": "1-Apply",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
