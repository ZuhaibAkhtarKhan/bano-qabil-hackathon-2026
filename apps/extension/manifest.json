{
  "manifest_version": 3,
  "name": "1-Apply",
  "version": "0.3.12",
  "description": "Save opportunities to 1-Apply and fill approved fields from your session.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "1-Apply",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "storage", "scripting", "cookies", "tabs", "alarms"],
  "host_permissions": ["http://3.108.122.44/*", "http://localhost:3000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
