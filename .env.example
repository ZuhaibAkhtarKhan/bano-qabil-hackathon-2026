# Server-only AI and embeddings (OpenAI-compatible HTTP). Generation is skipped if unset.
# Gemini (recommended for this project): put your Google AI Studio key in OPENAI_API_KEY.
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-3.6-flash
# EMBEDDING_MODEL=gemini-embedding-001
#
# Or OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=text-embedding-3-small

# Optional Groq (OpenAI-compatible). Preferred for posting rewrite when set.
GROQ_API_KEY=xai-feijRe6IhUC4ZL2YHRIoFVwobyYsD0lKMxGgdk0Zm2yxqMSPun7LrAf3XAPaez640IOP7NcfH634bfx3
GROQ_MODEL=openai/gpt-oss-20b

# Optional Google login. After creating the OAuth client, add these Authorized redirect URIs:
#   http://localhost:3000/api/integrations/callback?kind=gmail
#   http://localhost:3000/api/integrations/callback?kind=google_calendar
TOKEN_ENCRYPTION_KEY=replace-with-token-encryption-key
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_SYNC_ENABLED=true
CALENDAR_SYNC_ENABLED=true
# Optional Tavily key for extra web discovery results.
TAVILY_API_KEY=
