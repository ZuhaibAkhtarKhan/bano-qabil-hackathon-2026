# Copy to apps/web/.env.local for local development.
# Never commit real secrets. Never prefix server secrets with NEXT_PUBLIC_.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_EXTENSION_ORIGIN=chrome-extension://your-extension-id

# Server-only database/storage admin. Workers only — never the browser or extension.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
STORAGE_BUCKET=application-documents

# Groq = fast real-time drafts in demos. Gemini (OPENAI_* vars) = extraction + embeddings.
AI_CHAT_PROVIDER=auto
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL=openai/gpt-oss-20b

# Gemini via Google AI Studio (OpenAI-compatible HTTP). Variable names are legacy — this is NOT OpenAI.
# Get a key: https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.1-flash-lite
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=gemini-embedding-001

# Extension build default (override in extension Options for local dev)
# EXTENSION_APP_BASE_URL=http://localhost:3000

# Cron automation (EC2). Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-cron-secret

# Server-side headless form fill + submit (Playwright on EC2). Keep true — the extension no longer executes host submit.
ENABLE_SERVER_HOST_SUBMIT=true

# Optional Google login. After creating the OAuth client, add these Authorized redirect URIs:
#   http://localhost:3000/api/integrations/callback?kind=gmail
#   http://localhost:3000/api/integrations/callback?kind=google_calendar
TOKEN_ENCRYPTION_KEY=replace-with-token-encryption-key
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_SYNC_ENABLED=false
CALENDAR_SYNC_ENABLED=false
# Optional Tavily key for extra web discovery results.
TAVILY_API_KEY=
